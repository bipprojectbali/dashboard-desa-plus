# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Format: postgresql://username:password@host:port/database?schema=public
# Contoh: postgresql://postgres:password123@db.example.com:5432/dashboard_desa?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/dashboard_desa?schema=public"

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================
# Minimum 32 characters, generate dengan: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-random-secret-min-32-characters"

# Admin user credentials (akan dibuat saat seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# GitHub OAuth (Optional - untuk login dengan GitHub)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===========================================
# EXTERNAL API CONFIGURATION
# ===========================================
# URL Website Desa (untuk ambil data APBDes, Responden, dll)
DESA_API_URL="https://desa-darmasaba-stg.wibudev.com"

# URL NOC Server (untuk sinkronisasi data)
NOC_API_URL="https://darmasaba.muku.id/api/noc/docs/json"

# ===========================================
# FRONTEND CONFIGURATION (VITE_*)
# ===========================================
# PENTING: Variables ini harus ada saat BUILD TIME
# Public URL aplikasi (untuk links dan redirects)
VITE_PUBLIC_URL="http://localhost:3000"

# External Desa API URL (untuk frontend direct access)
VITE_DESA_API_URL="https://desa-darmasaba-stg.wibudev.com"

# Jenna AI Analytics API
VITE_JENNA_API_URL="https://desa-platform-stg.wibudev.com"
VITE_JENNA_API_TOKEN="your-jenna-bearer-token-here"

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# React Editor (untuk dev-only)
# REACT_EDITOR="code"  # VS Code
# REACT_EDITOR="antigravity"  # Antigravity
